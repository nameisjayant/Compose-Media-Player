<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AndroidPractice" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: the logo on the media canvas, then swaps to the app theme. Below
         Android 12 the static mark is shown; values-v31 swaps in the animated one. -->
    <style name="Theme.AndroidPractice.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/media_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AndroidPractice</item>
    </style>
</resources>
